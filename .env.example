VITE_SPREADSHEET_ID=
VITE_GEMINI_API_KEY=
# 정식 도메인(canonical/og:url/sitemap 생성 기준). 커스텀 도메인 쓸 때만 값 채우면 됨 (미설정 시 config.js 기본값 사용)
VITE_SITE_URL=
VITE_CARTO_API_KEY=

# GeoJSON 사용 로그를 받을 Apps Script 웹앱 URL.
# 서버(루트 middleware.js)만 읽으므로 VITE_ 접두어를 붙이지 않는다.
# (붙이면 클라이언트 번들에 노출돼 누구나 가짜 로그를 넣을 수 있다)
# 로컬 dev 서버에서는 middleware 가 돌지 않으므로 비워 둬도 된다.
TRACK_URL=
